    def load_employee(self, employee_name):
        if employee_name not in employees:
            return
        
        employee= employees[employee_name]
        
        self.inputs["Employee no."].setText(str(employee.get("Employee ID", "") or ""))

        self.inputs["Department"].setText(employee.get("DEPARTMENT", "") or "")
        self.inputs["Position"].setText(employee.get("POSITION", "") or "")
        
        salary= employee.get("MONTHLY SALARY")
        
        try:
            salary= float(salary or 0.0)
        except (ValueError, TypeError):
            salary= 0.0
            
        self.inputs["Monthly salary"].setValue(float(salary))
        
        print("Selected employee: ", employee_name)
        print("Monthly salary: ", salary)
        if hasattr(self, "period_lbl"):
            self.recalculate()

