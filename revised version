        scroll.setWidget(self.payslip_widget)

        self.recalculate()
        return scroll
    
    # --------------------------------------------------------
    # Reads every input and updates the payslip
    # Runs automatically whenever any input changes
    # --------------------------------------------------------
    def recalculate(self):
        if not hasattr(self, "period_lbl"):
            return
        if not hasattr(self, "inputs") or not self.inputs:
            return
        
        # ============================================================
        # TEXT FIELDS
        # ============================================================

        month = self.inputs["Month"].currentText()
        cutoff = self.inputs["Cut-off"].currentText()
        year = self.inputs["Year"].currentText()
        self.period_lbl.setText(f" {month.upper()} {cutoff}, {year}")

        self.emp_info_labels["EMPLOYEE NO."].setText(self.inputs["Employee no."].text() or "-")
        self.emp_info_labels["NAME"].setText(self.employee_dropdown.currentText() or "-")
        self.emp_info_labels["DEPARTMENT"].setText(self.inputs["Department"].text() or "-")
        self.emp_info_labels["POSITION"].setText(self.inputs["Position"].text() or "-")
        
        # ============================================================
        # NUMERIC INPUTS
        # ============================================================

        monthly_salary = self.inputs["Monthly salary"].value()
        working_days = self.inputs["Working days"].value()
        absences = self.inputs["Absences"].value()
        hours_per_day = self.inputs["Hours per day"].value()
        ot_hours = self.inputs["OT hours"].value()
        ot_multiplier = self.inputs["OT multiplier"].value()
        nd_hours = self.inputs["ND hours"].value()
        nd_rate = self.inputs["ND rate"].value() /100.0

        other_earnings = 0.0

        sss_rate = self.inputs["SSS rate"].value() / 100.0
        philhealth_rate = self.inputs["PhilHealth rate"].value() / 100.0
        pagibig_rate = self.inputs["Pag-IBIG rate"].value() / 100.0
        tax_rate = self.inputs["Tax rate"].value() / 100.0
        tax_deduction = self.inputs["Tax deduction"].value()
        loans = self.inputs["Loans"].value()
        other_deductions = self.inputs["Other deductions"].value()

        # ============================================================
        # COMPUTATION
        # ============================================================

        res = compute_payslip(
            monthly_salary=monthly_salary,
            working_days=working_days,
            absences=absences,
            hours_per_day=hours_per_day,
            ot_hours=ot_hours,
            ot_multiplier=ot_multiplier,
            nd_hours=nd_hours,
            nd_rate=nd_rate,
            other_earnings=other_earnings,
            sss_rate=sss_rate,
            philhealth_rate=philhealth_rate,
            pagibig_rate=pagibig_rate,
            tax_rate=tax_rate,
            tax_deduction=tax_deduction,
            loans=loans,
            other_deductions=other_deductions,
        )

        # ============================================================
        # UPDATE PAYSLIP PREVIEW
        # ============================================================

        self.emp_info_labels["DAILY RATE"].setText(f"{res['daily_rate']:,.2f}")
        self.emp_info_labels["HOURLY RATE"].setText(f"{res['hourly_rate']:,.2f}")
        self.emp_info_labels["WORKING DAYS"].setText(f"{working_days:,.2f}")
        self.emp_info_labels["ABSENCES"].setText(f"{absences:,.2f}")

        self.earnings_map["BASIC PAY"].setText(f"{res['basic_pay']:,.2f}")
        self.earnings_map["OVERTIME PAY"].setText(f"{res['overtime_pay']:,.2f}")
        self.earnings_map["NIGHT DIFFERENTIAL"].setText(f"{res['night_differential']:,.2f}")

        self.deductions_map["SSS"].setText(f"{res['sss']:,.2f}")
        self.deductions_map["PHILHEALTH"].setText(f"{res['philhealth']:,.2f}")
        self.deductions_map["PAG-IBIG"].setText(f"{res['pagibig']:,.2f}")
        self.deductions_map["WITHHOLDING TAX"].setText(f"{res['withholding_tax']:,.2f}")
        self.deductions_map["OTHER DEDUCTIONS"].setText(f"{res['other_deductions']:,.2f}")
        self.deductions_map["ABSENCES"].setText(f"{res['absences']:,.2f}")
        self.deductions_map["LOANS"].setText(f"{res['loans']:,.2f}")

        self.gross_pay_lbl.setText(f"{res['gross_pay']:,.2f}")
        self.total_deductions_lbl.setText(f"{res['total_deductions']:,.2f}")
        self.net_amount_lbl.setText(f"{res['net_pay']:,.2f}")
        
        # ============================================================
        # SAVE PAYSLIP 
        # ============================================================
    def save_payslip(self):
        if not hasattr(self, "payslip_widget") or self.payslip_widget is None:
            return

        file_path, _ = QFileDialog.getSaveFileName(self,"Save Payslip","payslip.png",
            "PNG Image (*.png);;JPEG Image (*.jpg *.jpeg)",)
        if not file_path:
            return

        pixmap = self.payslip_widget.grab()
        if pixmap.save(file_path):
            QMessageBox.information(self, "Success", f"Payslip successfully saved to:\n{file_path}")
        else:
            QMessageBox.critical(self, "Error", "Failed to save payslip image file.")


