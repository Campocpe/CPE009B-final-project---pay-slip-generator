# ---------- Earnings ----------

def daily_rate(monthly_salary, working_days):
    """Daily rate = Monthly salary ÷ (Working days × 2 cut-offs)"""
    return monthly_salary / (working_days * 2) if working_days else 0.0


def basic_pay(daily_rate_value, working_days):
    """Basic pay = Daily rate × Working days"""
    return daily_rate_value * working_days


def hourly_rate(daily_rate_value, hours_per_day):
    """Hourly rate = Daily rate ÷ Hours per day"""
    return daily_rate_value / hours_per_day if hours_per_day else 0.0


def overtime_pay(hourly_rate_value, ot_hours, ot_multiplier):
    """Overtime pay = Hourly rate × OT hours × OT multiplier"""
    return hourly_rate_value * ot_hours * ot_multiplier


def night_differential(hourly_rate_value, nd_hours, nd_rate):
    """Night differential = Hourly rate × Night hours × ND rate"""
    return hourly_rate_value * nd_hours * nd_rate


def gross_pay(basic, overtime, night_diff, other_earnings=0.0):
    """Gross pay = Basic pay + Overtime pay + Night differential"""
    return basic + overtime + night_diff + other_earnings

# ---------- Deductions ----------

def sss(applicable_salary, sss_rate):
    """SSS = Applicable salary × SSS contribution rate"""
    return applicable_salary * sss_rate


def philhealth(applicable_salary, philhealth_rate):
    """PhilHealth = Applicable salary × PhilHealth contribution rate"""
    return applicable_salary * philhealth_rate


def pagibig(applicable_salary, pagibig_rate):
    """Pag-IBIG = Applicable salary × Pag-IBIG contribution rate"""
    return applicable_salary * pagibig_rate

def absence_deduction(daily_rate_value, absences):
    """Absences = Daily rate × Days absent"""
    return daily_rate_value * absences


def withholding_tax(taxable_compensation, tax_rate, applicable_deduction=0.0):
    """Withholding tax = Taxable compensation × Applicable tax rate − Applicable deduction"""
    return max(taxable_compensation * tax_rate - applicable_deduction, 0.0)


def total_deductions(sss_amt, philhealth_amt, pagibig_amt, tax_amt, absence_amt, loans, other_deductions=0.0):
    """Total deductions = SSS + PhilHealth + Pag-IBIG + Withholding tax + Absences + Loans + Other deductions"""
    return sss_amt + philhealth_amt + pagibig_amt + tax_amt + absence_amt + loans + other_deductions

# ---------- Final ----------

def net_pay(gross, deductions):
    """Net pay = Gross pay − Total deductions"""
    return gross - deductions


# ---------- Full computation ----------

def compute_payslip(
    monthly_salary,
    working_days,
    absences,
    hours_per_day,
    ot_hours=0.0,
    ot_multiplier=1.3,
    nd_hours=0.0,
    nd_rate=0.10,
    other_earnings=0.0,
    applicable_salary=None,
    sss_rate=0.0,
    philhealth_rate=0.0,
    pagibig_rate=0.0,
    taxable_compensation=None,
    tax_rate=0.0,
    tax_deduction=0.0,
    loans=0.0,
    other_deductions=0.0,
):
    applicable_salary = monthly_salary if applicable_salary is None else applicable_salary

    d_rate = daily_rate(monthly_salary, working_days)
    h_rate = hourly_rate(d_rate, hours_per_day)

    basic = basic_pay(d_rate, working_days)
    ot = overtime_pay(h_rate, ot_hours, ot_multiplier)
    nd = night_differential(h_rate, nd_hours, nd_rate)
    gross = gross_pay(basic, ot, nd, other_earnings)

    sss_amt = sss(applicable_salary, sss_rate)
    ph_amt = philhealth(applicable_salary, philhealth_rate)
    pi_amt = pagibig(applicable_salary, pagibig_rate)
    abs_amt = absence_deduction(d_rate, absences)

    # Default taxable compensation
    if taxable_compensation is None:
        taxable_compensation = gross - abs_amt - (sss_amt + ph_amt + pi_amt)
    tax_amt = withholding_tax(taxable_compensation, tax_rate, tax_deduction)

    deductions = total_deductions(sss_amt, ph_amt, pi_amt, tax_amt, abs_amt, loans, other_deductions)
    net = net_pay(gross, deductions)

    return {
        "daily_rate": round(d_rate, 2),
        "hourly_rate": round(h_rate, 2),
        "basic_pay": round(basic, 2),
        "overtime_pay": round(ot, 2),
        "night_differential": round(nd, 2),
        "other_earnings": round(other_earnings, 2),
        "gross_pay": round(gross, 2),
        "sss": round(sss_amt, 2),
        "philhealth": round(ph_amt, 2),
        "pagibig": round(pi_amt, 2),
        "absences": round(abs_amt, 2),
        "taxable_compensation": round(taxable_compensation, 2),
        "withholding_tax": round(tax_amt, 2),
        "loans": round(loans, 2),
        "other_deductions": round(other_deductions, 2),
        "total_deductions": round(deductions, 2),
        "net_pay": round(net, 2),
    }


# ---------- UI helpers ----------

def box():
    frame = QFrame()
    frame.setFrameShape(QFrame.Shape.Box)
    return frame


def vline():
    line = QFrame()
    line.setFrameShape(QFrame.Shape.VLine)
    line.setFrameShadow(QFrame.Shadow.Plain)
    return line


def amount_label(text="0.00"):
    label = QLabel(text)
    label.setAlignment(Qt.AlignmentFlag.AlignRight | Qt.AlignmentFlag.AlignVCenter)
    return label


def spin(value=0.0, maximum=10_000_000.0, suffix=""):
    s = QDoubleSpinBox()
    s.setRange(0, maximum)
    s.setValue(value)
    s.setGroupSeparatorShown(True)
    if suffix:
        s.setSuffix(suffix)
    return s


